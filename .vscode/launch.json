{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run EduGenie Server (Web App)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "args": ["8085"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "📊 Run EduGenie (Streamlit App)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py", "--server.port=8501"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🧪 Run EduGenie Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_services.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
